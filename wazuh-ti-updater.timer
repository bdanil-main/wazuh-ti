# ~/.config/systemd/user/wazuh-ti-updater.timer
# Чтобы таймер работал без открытой сессии пользователя: loginctl enable-linger $USER
[Unit]
Description=Daily update of Wazuh Threat Intelligence CDB lists

[Timer]
# Раз в сутки ночью; случайная задержка до 15 минут снимает пиковую нагрузку на источники
OnCalendar=*-*-* 03:20:00
RandomizedDelaySec=15min
# Если хост был выключен в момент запуска, обновление выполнится после включения
Persistent=true
Unit=wazuh-ti-updater.service

[Install]
WantedBy=timers.target
