# /etc/cron.d/wazuh-ti-updater
# Альтернатива systemd timer: используйте ОДИН из двух вариантов, не оба сразу.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
20 3 * * * root /usr/bin/python3 /usr/local/sbin/wazuh-ti-updater.py --config /etc/wazuh-ti/config.ini >/dev/null 2>&1
